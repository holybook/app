# Copy this to `.env` on the droplet (next to compose.yaml) and `chmod 600 .env`.
# The deploy workflow recreates this file from GitHub secrets on every deploy,
# so the real .env never lives in git.

# Domain Caddy serves and provisions a TLS certificate for.
# Use ":80" for a quick plain-HTTP test against the droplet IP.
SITE_ADDRESS=holybook.app

# Password for the Postgres `server` owner role (used by the importer).
DB_PASSWORD=change-me

# Password for the read-only `webapp` role the server connects as.
# Use a different value from DB_PASSWORD.
WEBAPP_PASSWORD=change-me-too

# Gemini API key for AI translation. Leave empty to disable the feature.
GEMINI_API_KEY=change-me

# Image to run (server and importer). CI sets this to the freshly pushed tag.
HOLYBOOK_IMAGE=ghcr.io/holybook/go:latest
